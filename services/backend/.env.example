# fal.ai API key used by the video analysis pipeline (analyzectl / POST /analyze).
# Copy this file to `.env` and fill in your key. `.env` is gitignored.
FAL_KEY=your-fal-key-here

# OpenAI Responses API key used by tutorial planning.
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-5-mini
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60

# fal-hosted ElevenLabs narration.
FAL_ELEVENLABS_ENDPOINT=https://fal.run/fal-ai/elevenlabs/tts/eleven-v3
FAL_TIMEOUT_SECONDS=60
NARRATION_CACHE_DIR=.cache/onshape-assist/narration

# Onshape API keys, used only by the backend to monitor and roll back a Part Studio.
ONSHAPE_ACCESS_KEY=your-onshape-access-key
ONSHAPE_SECRET_KEY=your-onshape-secret-key
# Use your enterprise domain when applicable, for example https://acme.onshape.com/api.
ONSHAPE_BASE_URL=https://cad.onshape.com/api
