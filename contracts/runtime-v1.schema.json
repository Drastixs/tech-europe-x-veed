{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onshape-assist.local/contracts/runtime-v1.schema.json",
  "title": "Onshape Assist runtime contract bundle",
  "type": "object",
  "required": ["contract_version", "tutorial_plan", "state_snapshot", "runtime_events", "validation_outcome", "error"],
  "properties": {
    "contract_version": { "const": 1 },
    "tutorial_plan": { "$ref": "#/$defs/tutorialPlan" },
    "state_snapshot": { "$ref": "#/$defs/stateSnapshot" },
    "runtime_events": { "type": "array", "items": { "$ref": "#/$defs/runtimeEvent" } },
    "validation_outcome": { "$ref": "#/$defs/validationOutcome" },
    "error": { "$ref": "#/$defs/error" }
  },
  "additionalProperties": false,
  "$defs": {
    "tutorialPlan": {
      "type": "object",
      "required": ["tutorial_id", "application", "output_language", "runtime_preferences", "voice", "steps"],
      "properties": {
        "tutorial_id": { "type": "string", "minLength": 1 },
        "application": { "type": "string", "minLength": 1 },
        "output_language": { "type": "string", "minLength": 1 },
        "runtime_preferences": { "type": "object", "required": ["detailed_narration"], "properties": { "detailed_narration": { "type": "boolean" } }, "additionalProperties": false },
        "voice": { "type": "object", "required": ["provider", "voice_id", "speaking_rate"], "properties": { "provider": { "const": "fal_elevenlabs" }, "voice_id": { "type": "string", "minLength": 1 }, "speaking_rate": { "type": "number", "exclusiveMinimum": 0 } }, "additionalProperties": false },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tutorialStep" } }
      },
      "additionalProperties": false
    },
    "tutorialStep": {
      "type": "object",
      "required": ["step_id", "goal", "preconditions", "actions", "narration", "voice_cues", "dynamic_corrections", "expected_end_state", "uncertainties"],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tutorialAction" } },
        "narration": { "$ref": "#/$defs/narration" },
        "voice_cues": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/voiceCue" } },
        "dynamic_corrections": { "$ref": "#/$defs/corrections" },
        "expected_end_state": { "type": "string", "minLength": 1 },
        "uncertainties": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "tutorialAction": {
      "type": "object",
      "required": ["sequence", "action_type", "ui_region", "target_label", "target_description", "semantic_action", "expected_visible_result", "preferred_activation", "fallback_activation"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "action_type": { "enum": ["move", "click", "double_click", "drag", "keypress", "type", "scroll", "wait", "selection"] },
        "ui_region": { "type": "string", "minLength": 1 },
        "target_label": { "type": ["string", "null"] },
        "target_description": { "type": "string", "minLength": 1 },
        "semantic_action": { "type": "string", "minLength": 1 },
        "expected_visible_result": { "type": "string", "minLength": 1 },
        "preferred_activation": { "enum": ["dom_js", "cdp", "vision_only"] },
        "fallback_activation": { "enum": ["cdp", null] }
      },
      "additionalProperties": false
    },
    "narration": { "type": "object", "required": ["concise", "detailed"], "properties": { "concise": { "$ref": "#/$defs/narrationVariant" }, "detailed": { "$ref": "#/$defs/narrationVariant" } }, "additionalProperties": false },
    "narrationVariant": { "type": "object", "required": ["text", "fal_elevenlabs_audio_url", "duration_ms"], "properties": { "text": { "type": "string", "minLength": 1 }, "fal_elevenlabs_audio_url": { "type": "string", "minLength": 1 }, "duration_ms": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "voiceCue": { "type": "object", "required": ["cue_id", "phase", "action_sequence", "variant", "text_ref", "start_policy", "blocking"], "properties": { "cue_id": { "type": "string", "minLength": 1 }, "phase": { "enum": ["before_step", "before_action", "during_action", "after_action", "after_step", "on_retry", "on_user_interrupt"] }, "action_sequence": { "type": "integer", "minimum": 1 }, "variant": { "enum": ["concise", "detailed", "both"] }, "text_ref": { "type": "string", "minLength": 1 }, "start_policy": { "enum": ["play_before_motion", "play_with_motion", "play_after_validation", "play_on_event"] }, "blocking": { "type": "boolean" } }, "additionalProperties": false },
    "corrections": { "type": "object", "required": ["retry", "target_relocated", "validation_failed", "user_interrupt"], "properties": { "retry": { "type": "string", "minLength": 1 }, "target_relocated": { "type": "string", "minLength": 1 }, "validation_failed": { "type": "string", "minLength": 1 }, "user_interrupt": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "stateSnapshot": { "type": "object", "required": ["session_id", "tutorial_id", "step_id", "state", "sequence"], "properties": { "session_id": { "type": "string", "minLength": 1 }, "tutorial_id": { "type": "string", "minLength": 1 }, "step_id": { "type": "string", "minLength": 1 }, "state": { "enum": ["demonstrating", "demo_visible", "restoring", "waiting", "learner_attempt", "validating", "complete", "paused", "failed"] }, "sequence": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "runtimeEvent": { "type": "object", "required": ["event", "session_id", "tutorial_id", "step_id", "timestamp_ms", "source"], "properties": { "event": { "enum": ["runtime.state.changed", "demo.action.completed", "user.takeover.detected", "user.takeover.clicked", "baseline.restore.confirmed", "learner.observation.captured", "validation.completed", "runtime.failed"] }, "session_id": { "type": "string", "minLength": 1 }, "tutorial_id": { "type": "string", "minLength": 1 }, "step_id": { "type": "string", "minLength": 1 }, "timestamp_ms": { "type": "integer", "minimum": 0 }, "source": { "enum": ["runtime", "learner", "executor", "validator", "observer"] } }, "additionalProperties": false },
    "validationOutcome": { "type": "object", "required": ["outcome", "microversion_id"], "properties": { "outcome": { "enum": ["correct", "wrong_tool", "no_committed_change", "unexpected_geometry", "concurrent_edit"] }, "microversion_id": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "error": { "type": "object", "required": ["code", "message", "recoverable"], "properties": { "code": { "enum": ["baseline_capture_failed", "target_not_found", "provider_unavailable", "restore_failed", "validation_failed", "relay_disconnected"] }, "message": { "type": "string", "minLength": 1 }, "recoverable": { "type": "boolean" } }, "additionalProperties": false }
  }
}
